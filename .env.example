# Copy to .env.local and fill in real values from
# Supabase dashboard → Project Settings → API
#
# Both vars are prefixed VITE_ so Vite exposes them to the browser bundle.
# The anon key is safe to ship in client code (designed for it); the
# service_role key is NOT and must never appear here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-public-key...
